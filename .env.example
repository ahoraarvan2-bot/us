# Public URL of the site (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where test-drive and contact requests are stored (JSON lines).
# On serverless hosts the project folder is read-only: point this at /tmp
# (temporary) or configure one of the forwarders below.
INQUIRY_STORE_PATH=./data/inquiries.jsonl

# Optional: also POST every request as JSON to this URL (Zapier, Make, n8n, your CRM…)
INQUIRY_WEBHOOK_URL=

# Optional: also send every request to a Telegram chat through a bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
